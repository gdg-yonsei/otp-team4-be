# ---------- 서버 ----------
PORT=8080
# 위키 생성 응답의 url 접두사 (https://katalk.wiki/w/{wikiId})
PUBLIC_BASE_URL=https://katalk.wiki
# 프론트엔드 Origin (쉼표 구분). 쿠키 포함 CORS 요청을 허용합니다.
ALLOWED_ORIGINS=http://localhost:3000

# ---------- 데이터베이스 ----------
# sqlite | postgres
DB_DRIVER=sqlite
# sqlite: 파일 경로 / postgres: DSN
DATABASE_URL=katalk-wiki.db
# DB_DRIVER=postgres
# DATABASE_URL=host=localhost user=postgres password=postgres dbname=katalk_wiki port=5432 sslmode=disable

# ---------- 세션 / 업로드 ----------
# 운영(HTTPS)에서는 true
COOKIE_SECURE=false
# 비밀번호 인증 세션 유효기간 (Go duration: 168h, 30m ...)
SESSION_TTL=168h
# 대화 파일 업로드 최대 크기 (MB)
MAX_UPLOAD_MB=50

# ---------- AI 에이전트 ----------
# 생성 요청을 보낼 에이전트 서버 URL (로컬: agent/ 를 uv run 으로 띄운 주소)
# 운영(deploy.sh)에서는 http://agent:8000/jobs 로 자동 지정된다.
AGENT_URL=http://localhost:8000/jobs
# 에이전트와 공유하는 Bearer 토큰 (예: openssl rand -hex 32)
AGENT_TOKEN=change-me
# 에이전트 요청 타임아웃 (실패 시 최대 3회 재시도)
AGENT_TIMEOUT=30s
# 이 시간 안에 끝나지 않은 작업은 FAILED 처리
JOB_TIMEOUT=60m

# ---------- AI 에이전트 서버 (agent/, Python) ----------
# 위의 AGENT_TOKEN을 같이 쓴다.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.2-astra
# 에이전트가 호출할 이 서버 주소. 운영(deploy.sh)에서는 http://otp-server:8080 으로 자동 지정된다.
API_URL=http://localhost:8080
# 모델 1회 입력 크기(문자 수). 넘으면 나눠서 호출하고, MAX_CHUNKS 조각을 넘으면 실패 처리.
# MAX_INPUT_CHARS=120000
# MAX_CHUNKS=8
# MAX_PAGES=40
# 문서 작성 동시 호출 수 (OpenAI TPM 한도에 걸리면 낮추기)
# WRITE_CONCURRENCY=10
